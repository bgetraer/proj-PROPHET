#PBS -S /bin/bash
#PBS -l select=1:ncpus=1:model=bro
#PBS -q long
#PBS -l walltime=0:02:00
#PBS -m e
#PBS -W group_list=s2013
#PBS -o /nobackupp18/bgetraer/issmjpl/proj-getraer/proj-PROPHET/pbs_scripts/outlog
#PBS -e /nobackupp18/bgetraer/issmjpl/proj-getraer/proj-PROPHET/pbs_scripts/errlog

. /usr/share/modules/init/bash

#load modules
module purge
module load mpi-hpe/mpt.2.30
module load mpi-hpe/mpt
module load comp-intel/2023.2.1
module load petsc/3.17.3_intel_mpt_py
module load hdf5/1.8.18_mpt hdf4/4.2.12 netcdf/4.4.1.1_mpt
module load matlab/2022b
module load szip/2.1.1

#module load mpi-hpe/mpt
#module load comp-intel
#module load hdf5/1.8.18_mpt hdf4/4.2.12 netcdf/4.4.1.1_mpt
#module load matlab/2022b
#module load petsc/3.17.3_intel_mpt_py

#Export some variables
export PATH='/nasa/netcdf/4.4.1.1_mpt/bin:/nasa/hdf5/1.8.18_mpt/bin:/nasa/intel/Compiler/2020.4.304/compilers_and_libraries_2020.4.304/linux/bin/intel64:/nasa/intel/Compiler/2020.4.304/compilers_and_libraries_2020.4.304/linux/bin:/nasa/hpe/mpt/2.30_rhel810/bin:/nasa/matlab/2022b/bin:/opt/clmgr/sbin:/opt/clmgr/bin:/opt/sgi/sbin:/opt/sgi/bin:/usr/share/Modules/bin:/usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin:/opt/c3/bin:/PBS/bin:/nobackup/bgetraer/trunk-jpl/aux-config:/nobackup/bgetraer/trunk-jpl/scripts:/nobackup/bgetraer/trunk-jpl/externalpackages/dyson/:/nasa/hdf4/4.2.12/bin:.'
export MPI_LAUNCH_TIMEOUT=800
export MPI_GROUP_MAX=800

#ISSM stuff
export ISSM_DIR="/nobackup/bgetraer/trunk-jpl"
source /nobackup/bgetraer/trunk-jpl/etc/environment.sh

echo "=== ldd mex file  ==="
ldd /home3/bgetraer/.mcrCache9.13/MCCexe17/nobackupp18/bgetraer/trunk-jpl/lib/IssmConfig_matlab.mexa64 
